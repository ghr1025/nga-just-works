<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        AppCompat fallback for the Miuix appearance. Pages are drawn by Miuix components; this
        theme only covers platform surfaces they cannot own (AlertDialogs, legacy View widgets)
        so those match the Miuix scheme instead of the classic brown/green/black palette.
    -->
    <style name="AppThemeDayNightMiuix" parent="@style/AppThemeDayNight">
        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="colorPrimaryDark">@color/miuix_surface</item>
        <item name="colorAccent">@color/miuix_primary</item>
        <item name="android:windowBackground">@color/miuix_surface</item>
        <!-- Classic AlertDialogs and DialogFragments: HyperOS card colour and corners. -->
        <item name="alertDialogTheme">@style/AppThemeDayNightMiuix.Dialog</item>
        <item name="android:alertDialogTheme">@style/AppThemeDayNightMiuix.Dialog</item>
        <item name="dialogTheme">@style/AppThemeDayNightMiuix.Dialog</item>
        <item name="android:dialogTheme">@style/AppThemeDayNightMiuix.Dialog</item>
    </style>

    <style name="AppThemeDayNightMiuix.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/miuix_primary</item>
        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="android:windowBackground">@drawable/miuix_dialog_background</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppThemeDayNightMiuix.DialogButton.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppThemeDayNightMiuix.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppThemeDayNightMiuix.DialogButton</item>
        <item name="android:textColorPrimary">@color/miuix_on_surface</item>
        <item name="android:textColorSecondary">@color/miuix_on_surface_summary</item>
        <!-- AppCompat AlertDialog layout with centred texts and capsule buttons. -->
        <item name="alertDialogStyle">@style/AppThemeDayNightMiuix.AlertDialogStyle</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="AppThemeDayNightMiuix.AlertDialogStyle" parent="AlertDialog.AppCompat">
        <item name="android:layout">@layout/miuix_alert_dialog</item>
    </style>

    <!-- Miuix dialog buttons: equal capsules, grey secondary and Miuix-primary confirm. -->
    <style name="AppThemeDayNightMiuix.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/miuix_on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/miuix_dialog_button_secondary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AppThemeDayNightMiuix.DialogButton.Primary">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/miuix_dialog_button_primary</item>
    </style>

    <style name="AppThemeDayNightMiuix.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
