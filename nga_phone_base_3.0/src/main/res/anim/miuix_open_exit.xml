<?xml version="1.0" encoding="utf-8"?>
<!-- Miuix open: the page underneath moves a quarter to the left and fades. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="500"
    android:interpolator="@interpolator/miuix_nav_easing"
    android:shareInterpolator="true">
    <translate android:fromXDelta="0" android:toXDelta="-25%" />
    <alpha android:fromAlpha="1.0" android:toAlpha="0.6" />
</set>
